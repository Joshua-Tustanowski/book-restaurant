PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# Test mode (npm run dev:poll:test). TEST_MODE is set by the script itself -
# leave it out of .env or it will leak into a real `npm run poll` run.
# TEST_OUTCOME=booked | still_waitlisted | error   (default: booked)
# TEST_SUBJECT_PREFIX=[bot-test]                   (default: [bot-test])
